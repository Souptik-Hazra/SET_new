# Raw and processed datasets: keep data private and out of Git.
/data/*
!/data/raw/
!/data/processed/
!/data/reference/
/data/raw/*
!/data/raw/.gitkeep
/data/processed/*
!/data/processed/.gitkeep
/data/reference/*
!/data/reference/.gitkeep
/dataset/
/datasets/

# Generated reports and large outputs.
/output/*
!/output/tables/
!/output/figures/
/output/tables/*
!/output/tables/.gitkeep
/output/figures/*
!/output/figures/.gitkeep

# Legacy large/local project directories.
/SET PROJECT/
/PharmacyTransactionalDataset/

# Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Environments
venv/
.venv/
env/

# Jupyter and temporary files
.ipynb_checkpoints/
*.log
.DS_Store
